# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
# Without the Google Sheet vars, the site falls back to the local JSON files
# in content/ — so it runs fine for local development with no secrets.
# On Vercel, add these same variables under Project → Settings → Environment
# Variables (paste the private key exactly, including the \n sequences).
# ---------------------------------------------------------------------------

# --- Google Sheets (service account, private sheet) ------------------------
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIB...\n-----END PRIVATE KEY-----\n"

# --- Publish webhook -------------------------------------------------------
# Any long random string. Call /api/revalidate?secret=THIS to push edits live.
REVALIDATE_SECRET=

# --- Public site URL -------------------------------------------------------
# Your live domain — used for canonicals, sitemap, OG tags, JSON-LD.
# Local: leave blank. Production: set to your Vercel/custom domain (no trailing slash),
# e.g. https://thesmartfares.com
NEXT_PUBLIC_SITE_URL=

# --- Analytics / Google Ads (optional) -------------------------------------
# GA4 / Google Ads measurement ID (e.g. G-XXXXXXXXXX). Blank = disabled.
NEXT_PUBLIC_GA_ID=
