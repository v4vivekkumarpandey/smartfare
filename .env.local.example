# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
# Without the Google Sheet vars, the site falls back to the local JSON files
# in content/ — so it runs fine for local development with no secrets.
# On Vercel, add these same variables under Project → Settings → Environment
# Variables (paste the private key exactly, including the \n sequences).
# ---------------------------------------------------------------------------

# --- Google Sheets (service account, private sheet) ------------------------
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIB...\n-----END PRIVATE KEY-----\n"

# --- Publish webhook -------------------------------------------------------
# Any long random string. Call /api/revalidate?secret=THIS to push edits live.
REVALIDATE_SECRET=

# --- Public site URL -------------------------------------------------------
# Your live domain — used for canonicals, sitemap, OG tags, JSON-LD.
# Local: leave blank. Production: set to your Vercel/custom domain (no trailing slash),
# e.g. https://thesmartfares.online
NEXT_PUBLIC_SITE_URL=

# --- Analytics / Google Ads (optional) -------------------------------------
# GA4 measurement ID (e.g. G-XXXXXXXXXX). Blank = disabled.
NEXT_PUBLIC_GA_ID=
# Google Ads tag ID (e.g. AW-XXXXXXXXX). Enables the Ads tag + Consent Mode v2.
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Google Ads conversion label for the "Get Code" action (e.g. AbC-D_efGhIj).
# Fires a conversion when a user reveals a code. Blank = no direct conversion.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# --- Google AdSense (blog/content pages only) ------------------------------
# Publisher id, e.g. ca-pub-1234567890123456. Enables the verification meta tag
# + ads.txt. Ads are only rendered on blog pages (never coupon pages).
# NOTE: do NOT enable AdSense "Auto ads" — use the manual unit only, or ads may
# appear on your paid-Google-Ads landing pages (arbitrage = policy violation).
NEXT_PUBLIC_ADSENSE_CLIENT=
# Ad unit slot id from AdSense (create a responsive Display unit), e.g. 1234567890
NEXT_PUBLIC_ADSENSE_SLOT=
